{
  "name": "image2prompt-core",
  "version": "0.1.0",
  "private": true,
  "description": "StyleSpec 编译器的 TypeScript 参考实现。Track B 的验证工装：规则先在这里改、跑通真图验证，再移植进 app/ 的 Swift 版。schema 在仓库根 ../schema。",
  "type": "module",
  "bin": {
    "i2p": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "i2p": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
